{
  "name": "defuss-storage",
  "version": "0.2.0",
  "description": "Isomorphic byte storage with memory, Node.js file and browser OPFS adapters.",
  "type": "module",
  "license": "MIT",
  "author": "Aron Homberg",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./opfs": {
      "import": {
        "types": "./dist/opfs.d.mts",
        "default": "./dist/opfs.mjs"
      },
      "require": {
        "types": "./dist/opfs.d.cts",
        "default": "./dist/opfs.cjs"
      }
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "ARCH.md",
    "CHANGELOG.md",
    "VALIDATION.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "build": "pkgroll --clean-dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "bun run typecheck && oxlint --deny-warnings",
    "test": "vitest run",
    "test:bun": "bun test tests/",
    "coverage": "vitest run --coverage",
    "test:browser": "node scripts/browser-test.mjs",
    "test:browsers": "node scripts/browser-test.mjs chromium firefox webkit",
    "test:package": "node scripts/package-test.mjs",
    "verify": "bun run lint && bun run build && bun run test && bun run test:package && bun run test:browser",
    "example": "bun examples/dson-frames.ts && bun examples/stream-ingest.ts",
    "bench": "node --expose-gc scripts/bench.mjs",
    "bench:bun": "bun --expose-gc scripts/bench.mjs",
    "bench:browsers": "node scripts/bench-browsers.mjs chromium firefox webkit",
    "prepublishOnly": "bun run verify"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "4.1.12",
    "defuss-dson": "1.3.0",
    "oxlint": "1.89.0",
    "pkgroll": "2.29.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
